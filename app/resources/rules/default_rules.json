{
  "version": "1.0.0",
  "rules": [
    {
      "id": "windows_temp",
      "category": "系统",
      "name": "Windows 临时文件",
      "description": "系统级临时目录 C:\\Windows\\Temp，通常包含安装包残留与系统服务产生的临时文件。",
      "paths": ["%WINDIR%\\Temp"],
      "patterns": ["*"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "windows_logs",
      "category": "系统",
      "name": "Windows 日志文件",
      "description": "C:\\Windows\\Logs 下的日志文件，用于排错时可重新生成。",
      "paths": ["%WINDIR%\\Logs"],
      "patterns": ["*.log", "*.txt", "*.etl", "*.xml"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "windows_software_distribution",
      "category": "系统",
      "name": "Windows Update 下载缓存",
      "description": "已下载安装的 Windows Update 安装包，可安全清理（更新已安装的不会重下）。",
      "paths": ["%WINDIR%\\SoftwareDistribution\\Download"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "windows_live_kernel_reports",
      "category": "系统",
      "name": "内核崩溃转储",
      "description": "Windows 内核崩溃生成的 Live Kernel Reports，用于排查后可删除。",
      "paths": ["%WINDIR%\\LiveKernelReports"],
      "patterns": ["*.dmp", "*.hdmp", "*.mdmp", "*.log", "*.txt"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "windows_minidump",
      "category": "系统",
      "name": "小型内存转储",
      "description": "C:\\Windows\\Minidump 下的崩溃转储。",
      "paths": ["%WINDIR%\\Minidump"],
      "patterns": ["*.dmp", "*.hdmp"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "windows_debug",
      "category": "系统",
      "name": "Windows 调试日志",
      "description": "C:\\Windows\\debug 下的旧调试日志。",
      "paths": ["%WINDIR%\\debug"],
      "patterns": ["*.log", "*.txt", "*.old", "*.dmp"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "memory_dmp",
      "category": "系统",
      "name": "完整内存转储 MEMORY.DMP",
      "description": "完整内存转储文件，可能很大。仅在你已分析或不需要排查时删除。",
      "paths": ["%WINDIR%"],
      "patterns": ["MEMORY.DMP"],
      "min_age_days": 14,
      "risk": "moderate",
      "requires_admin": true,
      "enabled_by_default": false
    },
    {
      "id": "service_profile_temp",
      "category": "系统",
      "name": "服务账户临时文件",
      "description": "LocalService/NetworkService 等系统账户的临时文件。",
      "paths": [
        "%WINDIR%\\ServiceProfiles\\LocalService\\AppData\\Local\\Temp",
        "%WINDIR%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Temp"
      ],
      "patterns": ["*"],
      "min_age_days": 3,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "user_temp",
      "category": "用户",
      "name": "用户临时文件",
      "description": "当前用户的 %TEMP% 目录，应用运行时产生的临时文件。",
      "paths": ["%TEMP%", "%LOCALAPPDATA%\\Temp"],
      "patterns": ["*"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "thumbnail_cache",
      "category": "用户",
      "name": "缩略图缓存",
      "description": "资源管理器缩略图缓存，自动重建。",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"],
      "patterns": ["thumbcache_*.db", "thumbcache_*_*.db", "iconcache_*.db"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "crash_dumps_user",
      "category": "用户",
      "name": "应用崩溃转储",
      "description": "用户目录下的崩溃转储文件。",
      "paths": ["%LOCALAPPDATA%\\CrashDumps", "%LOCALAPPDATA%\\Microsoft\\Windows\\WER"],
      "patterns": ["*.dmp", "*.mdmp", "*.hdmp", "*.wer"],
      "min_age_days": 14,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "wer_reports",
      "category": "用户",
      "name": "Windows 错误报告归档",
      "description": "Windows Error Reporting 上报后归档的报告。",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\WER\\ReportArchive", "%LOCALAPPDATA%\\Microsoft\\Windows\\WER\\ReportQueue"],
      "patterns": ["*"],
      "min_age_days": 14,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "recent_files",
      "category": "用户",
      "name": "最近使用的文件",
      "description": "Recent 快捷方式（指向最近打开的文档）。",
      "paths": ["%APPDATA%\\Microsoft\\Windows\\Recent"],
      "patterns": ["*.lnk"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": false
    },
    {
      "id": "edge_cache",
      "category": "浏览器",
      "name": "Microsoft Edge 缓存",
      "description": "Edge 浏览器缓存（图片/视频等），自动重建。",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default"],
      "patterns": ["Cache", "Code Cache", "GPUCache", "Service Worker\\CacheStorage", "File System"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "chrome_cache",
      "category": "浏览器",
      "name": "Google Chrome 缓存",
      "description": "Chrome 浏览器缓存。",
      "paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Profile *"
      ],
      "patterns": ["Cache", "Code Cache", "GPUCache", "Service Worker\\CacheStorage", "File System"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "firefox_cache",
      "category": "浏览器",
      "name": "Mozilla Firefox 缓存",
      "description": "Firefox 浏览器缓存。",
      "paths": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles"],
      "patterns": ["cache2", "thumbnails", "OfflineCache"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "brave_cache",
      "category": "浏览器",
      "name": "Brave 浏览器缓存",
      "description": "Brave 浏览器缓存。",
      "paths": ["%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\Default"],
      "patterns": ["Cache", "Code Cache", "GPUCache"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "discord_cache",
      "category": "应用",
      "name": "Discord 缓存",
      "description": "Discord 应用缓存。",
      "paths": ["%APPDATA%\\discord\\Cache", "%APPDATA%\\discord\\Code Cache", "%APPDATA%\\discord\\GPUCache"],
      "patterns": ["*"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "slack_cache",
      "category": "应用",
      "name": "Slack 缓存",
      "description": "Slack 桌面应用缓存。",
      "paths": ["%APPDATA%\\Slack\\Cache", "%APPDATA%\\Slack\\Code Cache", "%APPDATA%\\Slack\\GPUCache"],
      "patterns": ["*"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "teams_cache",
      "category": "应用",
      "name": "Microsoft Teams 缓存",
      "description": "新版 Teams (work/school) 缓存。",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Teams"],
      "patterns": ["Cache", "Code Cache", "GPUCache", "blob_storage"],
      "min_age_days": 1,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "zoom_cache",
      "category": "应用",
      "name": "Zoom 缓存",
      "description": "Zoom 会议客户端缓存。",
      "paths": ["%APPDATA%\\Zoom\\data"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "spotify_cache",
      "category": "应用",
      "name": "Spotify 缓存",
      "description": "Spotify 桌面客户端缓存。",
      "paths": ["%LOCALAPPDATA%\\Spotify\\Data"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "vscode_cache",
      "category": "应用",
      "name": "Visual Studio Code 缓存",
      "description": "VS Code 缓存与日志。",
      "paths": ["%APPDATA%\\Code\\Cache", "%APPDATA%\\Code\\Code Cache", "%APPDATA%\\Code\\GPUCache", "%APPDATA%\\Code\\CachedData", "%APPDATA%\\Code\\CachedExtensions"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "cursor_cache",
      "category": "应用",
      "name": "Cursor 缓存",
      "description": "Cursor AI 编辑器缓存。",
      "paths": ["%APPDATA%\\Cursor\\Cache", "%APPDATA%\\Cursor\\Code Cache", "%APPDATA%\\Cursor\\GPUCache", "%APPDATA%\\Cursor\\CachedData"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "jetbrains_cache",
      "category": "应用",
      "name": "JetBrains IDE 缓存",
      "description": "JetBrains 全家桶（IntelliJ/PyCharm/WebStorm 等）缓存与本地历史。",
      "paths": [
        "%LOCALAPPDATA%\\JetBrains",
        "%LOCALAPPDATA%\\IntelliJIdea*",
        "%LOCALAPPDATA%\\PyCharm*",
        "%LOCALAPPDATA%\\WebStorm*",
        "%LOCALAPPDATA%\\GoLand*",
        "%LOCALAPPDATA%\\CLion*",
        "%LOCALAPPDATA%\\PhpStorm*",
        "%LOCALAPPDATA%\\Rider*",
        "%LOCALAPPDATA%\\RubyMine*",
        "%LOCALAPPDATA%\\DataGrip*"
      ],
      "patterns": ["caches", "log", "Local\\History", "tmp"],
      "min_age_days": 14,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "steam_cache",
      "category": "应用",
      "name": "Steam 缓存",
      "description": "Steam 客户端缓存。",
      "paths": ["%LOCALAPPDATA%\\Steam\\htmlcache", "%PROGRAMFILES(x86)%\\Steam\\appcache"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "epic_cache",
      "category": "应用",
      "name": "Epic Games Launcher 缓存",
      "description": "Epic Launcher 缓存。",
      "paths": ["%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\webcache", "%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\Logs"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "nvidia_shader_cache",
      "category": "应用",
      "name": "NVIDIA 着色器缓存",
      "description": "NVIDIA 驱动着色器编译缓存，自动重建。",
      "paths": ["%LOCALAPPDATA%\\NVIDIA\\DXCache", "%LOCALAPPDATA%\\NVIDIA\\GLCache", "%PROGRAMDATA%\\NVIDIA Corporation\\NV_Cache"],
      "patterns": ["*"],
      "min_age_days": 14,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "amd_shader_cache",
      "category": "应用",
      "name": "AMD 着色器缓存",
      "description": "AMD 驱动着色器编译缓存。",
      "paths": ["%LOCALAPPDATA%\\AMD\\VkCache", "%LOCALAPPDATA%\\AMD\\DxCache", "%PROGRAMDATA%\\AMD\\ShaderCache"],
      "patterns": ["*"],
      "min_age_days": 14,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "adobe_cache",
      "category": "应用",
      "name": "Adobe 媒体缓存",
      "description": "Adobe 系列软件（Photoshop/Premiere 等）的媒体缓存。",
      "paths": ["%APPDATA%\\Adobe\\Common\\Media Cache", "%APPDATA%\\Adobe\\Common\\Media Cache Files"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "npm_cache",
      "category": "开发工具",
      "name": "npm 缓存",
      "description": "Node.js npm 包管理器缓存，删除后可重下。",
      "paths": ["%LOCALAPPDATA%\\npm-cache", "%APPDATA%\\npm-cache"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "yarn_cache",
      "category": "开发工具",
      "name": "Yarn 缓存",
      "description": "Yarn v1 缓存目录。",
      "paths": ["%LOCALAPPDATA%\\Yarn\\Cache"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "pnpm_cache",
      "category": "开发工具",
      "name": "pnpm 缓存",
      "description": "pnpm 存储。",
      "paths": ["%LOCALAPPDATA%\\pnpm\\store", "%LOCALAPPDATA%\\pnpm\\cache"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "pip_cache",
      "category": "开发工具",
      "name": "pip 缓存",
      "description": "Python pip 包缓存。",
      "paths": ["%LOCALAPPDATA%\\pip\\cache"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "uv_cache",
      "category": "开发工具",
      "name": "uv 缓存",
      "description": "Astral uv 工具缓存。",
      "paths": ["%LOCALAPPDATA%\\uv"],
      "patterns": ["*"],
      "min_age_days": 7,
      "risk": "safe",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "cargo_cache",
      "category": "开发工具",
      "name": "Rust Cargo 缓存",
      "description": "Rust 编译缓存与注册表缓存。",
      "paths": ["%USERPROFILE%\\.cargo\\registry\\cache", "%USERPROFILE%\\.cargo\\registry\\src"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "go_cache",
      "category": "开发工具",
      "name": "Go 模块缓存",
      "description": "Go 模块下载缓存。",
      "paths": ["%LOCALAPPDATA%\\go-build", "%USERPROFILE%\\go\\pkg\\mod\\cache"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "gradle_cache",
      "category": "开发工具",
      "name": "Gradle 缓存",
      "description": "Gradle 依赖缓存与 daemon 缓存。",
      "paths": ["%USERPROFILE%\\.gradle\\caches", "%USERPROFILE%\\.gradle\\daemon"],
      "patterns": ["*"],
      "min_age_days": 14,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "maven_cache",
      "category": "开发工具",
      "name": "Maven 仓库",
      "description": "Maven 本地仓库缓存，删除后可重下。",
      "paths": ["%USERPROFILE%\\.m2\\repository"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "nuget_cache",
      "category": "开发工具",
      "name": "NuGet 缓存",
      "description": "NuGet 全局包文件夹与缓存。",
      "paths": ["%USERPROFILE%\\.nuget\\packages"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": true
    },
    {
      "id": "huggingface_cache",
      "category": "开发工具",
      "name": "Hugging Face 模型缓存",
      "description": "Hugging Face 下载的模型与数据集。删除后再次运行时会重下。",
      "paths": ["%USERPROFILE%\\.cache\\huggingface"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": false
    },
    {
      "id": "ollama_models",
      "category": "开发工具",
      "name": "Ollama 模型",
      "description": "Ollama 本地大模型文件，可能非常大。",
      "paths": ["%USERPROFILE%\\.ollama\\models"],
      "patterns": ["*"],
      "min_age_days": 30,
      "risk": "risky",
      "requires_admin": false,
      "enabled_by_default": false
    },
    {
      "id": "docker_logs",
      "category": "开发工具",
      "name": "Docker 容器日志",
      "description": "Docker 容器日志文件。",
      "paths": ["%PROGRAMDATA%\\Docker"],
      "patterns": ["*.log"],
      "min_age_days": 14,
      "risk": "safe",
      "requires_admin": true,
      "enabled_by_default": true
    },
    {
      "id": "playwright_cache",
      "category": "开发工具",
      "name": "Playwright 浏览器缓存",
      "description": "Playwright 测试用浏览器二进制缓存。",
      "paths": ["%USERPROFILE%\\AppData\\Local\\ms-playwright"],
      "patterns": ["*"],
      "min_age_days": 14,
      "risk": "moderate",
      "requires_admin": false,
      "enabled_by_default": false
    },
    {
      "id": "recycle_bin",
      "category": "高级",
      "name": "清空回收站",
      "description": "彻底清空回收站中所有文件（不可恢复！请先确认无重要文件）。",
      "paths": ["C:\\$Recycle.Bin"],
      "patterns": ["*"],
      "min_age_days": 0,
      "risk": "risky",
      "requires_admin": true,
      "enabled_by_default": false
    }
  ]
}